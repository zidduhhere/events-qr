{
  "name": "events-qr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts-dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dev:lan": "node scripts-dev.mjs --https",
    "https:setup": "node scripts/setup-https.mjs",
    "db:import-postgres": "node --env-file-if-exists=.env server/import-postgres.ts",
    "db:import-excel": "node --env-file-if-exists=.env server/import-excel.ts",
    "qr:export": "node --env-file-if-exists=.env server/export-qr.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "lucide-react": "^1.75.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
